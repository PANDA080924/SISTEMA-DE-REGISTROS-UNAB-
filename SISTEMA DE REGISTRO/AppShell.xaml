<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SISTEMA_DE_REGISTRO.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SISTEMA_DE_REGISTRO.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- Vista inicial: Login -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Panel Principal al que accederás tras el login -->
    <ShellContent
        Title="Panel Principal"
        ContentTemplate="{DataTemplate views:PanelPrincipalPage}"
        Route="PanelPrincipalPage" />

</Shell>