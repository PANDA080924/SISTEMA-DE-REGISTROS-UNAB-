<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SISTEMA_DE_REGISTRO.Views.ControlAccesoPage"
             BackgroundColor="#121824"
             Shell.NavBarIsVisible="False"
             Title="Control de Garita">

    <Grid RowDefinitions="Auto, *">

        <!-- Header Superior Oscuro -->
        <Grid Grid.Row="0" BackgroundColor="#1E293B" HeightRequest="56" Padding="12,0" ColumnDefinitions="Auto, *">
            <ImageButton Grid.Column="0" Source="dotnet_bot.png" WidthRequest="22" HeightRequest="22" Clicked="OnVolverClicked" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="Control de Acceso - Garita" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="12,0,0,0"/>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="420" HorizontalOptions="Center">

                <!-- Buscador rápido por Serie/Código -->
                <Label Text="Búsqueda de Dispositivo" TextColor="#94A3B8" FontSize="14" FontAttributes="Bold"/>

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Entry x:Name="txtBusqueda" Placeholder="N° Serie o Código Estudiante" PlaceholderColor="#64748B" TextColor="White" BackgroundColor="Transparent"/>
                        <BoxView HeightRequest="1" Color="#475569"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="Buscar" Clicked="OnBuscarClicked" BackgroundColor="#2563EB" TextColor="White" HeightRequest="40" CornerRadius="6" VerticalOptions="Start"/>
                </Grid>

                <Button Text="Escanear Código QR" Clicked="OnEscanearQRClicked" BackgroundColor="#0EA5E9" TextColor="White" HeightRequest="44" CornerRadius="8" FontAttributes="Bold"/>

                <!-- Tarjeta de Resultados del Estudiante / Equipo -->
                <Border BackgroundColor="#1E293B" StrokeThickness="1" Stroke="#334155" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="INFORMACIÓN DETECTADA" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold"/>

                        <Label x:Name="lblEstudiante" Text="Estudiante: -" TextColor="White" FontSize="15" FontAttributes="Bold"/>
                        <Label x:Name="lblCodigo" Text="Código: -" TextColor="#94A3B8" FontSize="14"/>
                        <Label x:Name="lblCarrera" Text="Carrera: -" TextColor="#94A3B8" FontSize="14"/>
                        <Label x:Name="lblEquipo" Text="Equipo: -" TextColor="#94A3B8" FontSize="14"/>
                        <Label x:Name="lblSerie" Text="N° Serie: -" TextColor="#94A3B8" FontSize="14"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botones de Acción: Entrada y Salida -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="REGISTRAR ENTRADA" Clicked="OnRegistrarEntradaClicked" BackgroundColor="#16A34A" TextColor="White" HeightRequest="50" CornerRadius="8" FontAttributes="Bold"/>
                    <Button Grid.Column="1" Text="REGISTRAR SALIDA" Clicked="OnRegistrarSalidaClicked" BackgroundColor="#DC2626" TextColor="White" HeightRequest="50" CornerRadius="8" FontAttributes="Bold"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>