<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SISTEMA_DE_REGISTRO.Views.LoginPage"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False"
             Title="Iniciar Sesión">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24" Spacing="24" VerticalOptions="Center" MaximumWidthRequest="400">

            <!-- Logo UNAB Circular -->
            <Border StrokeShape="RoundRectangle 60" 
                    WidthRequest="110" 
                    HeightRequest="110" 
                    BackgroundColor="#FFFFFF" 
                    StrokeThickness="0" 
                    HorizontalOptions="Center"
                    Padding="8">
                <Image Source="dotnet_bot.png" Aspect="AspectFit"/>
            </Border>

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Sistema UNAB" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center"/>
                <Label Text="Ingresa tus credenciales para acceder" FontSize="13" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">
                <Entry x:Name="txtCorreo" 
                       Placeholder="Correo Institucional" 
                       PlaceholderColor="#64748B" 
                       TextColor="White" 
                       Keyboard="Email"/>

                <Entry x:Name="txtPassword" 
                       Placeholder="Contraseña" 
                       PlaceholderColor="#64748B" 
                       TextColor="White" 
                       IsPassword="True"/>

                <Button Text="Iniciar Sesión" 
                        Clicked="OnLoginClicked" 
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        HeightRequest="48" 
                        CornerRadius="8" 
                        FontAttributes="Bold" 
                        Margin="0,10,0,0"/>

                <!-- Enlace interactivo para Registrarse -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                    <Label Text="¿No tienes cuenta?" TextColor="#94A3B8" FontSize="13"/>
                    <Label Text="Regístrate aquí" TextColor="#3B82F6" FontSize="13" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegistroTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>